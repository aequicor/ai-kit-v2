{
  "schemaVersion": 1,
  "agent": "claude-code",
  "minVersion": "1.0.0",
  "scope": "project",

  "settings": {
    "includeCoAuthoredBy": false,
    "permissions": {
      "defaultMode": "acceptEdits",
      "allow": [
        { "value": "Read(./**)" },
        { "value": "Bash(./gradlew:*)" },
        { "value": "Bash(git status)" },
        { "value": "Bash(git diff:*)" },
        { "value": "Bash(git log:*)" }
      ],
      "deny": [
        { "value": "Read(./.env)" },
        { "value": "Read(./secrets/**)" },
        { "value": "Read(./local.properties)" },
        { "value": "Bash(rm -rf:*)", "when": "${bundle.input.strict}" },
        { "value": "Bash(git push --force:*)", "when": "${bundle.input.strict}" }
      ]
    }
  },

  "memory": [
    { "name": "CLAUDE.md", "source": "CLAUDE.md" }
  ],

  "mcpServers": [
    {
      "when": "${bundle.input.githubMcp}",
      "name": "github",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"]
    },
    {
      "when": "${bundle.input.serenaMcp}",
      "name": "serena",
      "transport": "stdio",
      "command": "uvx",
      "args": ["--from", "serena", "serena", "--project-dir", "."]
    }
  ],

  "agents": [
    {
      "when": "'kotlin-specialist' in ${bundle.input.subagents}",
      "name": "kotlin-specialist",
      "source": "subagents/kotlin-specialist/kotlin-specialist.md"
    },
    {
      "when": "'gradle-troubleshooter' in ${bundle.input.subagents}",
      "name": "gradle-troubleshooter",
      "source": "subagents/gradle-troubleshooter/gradle-troubleshooter.md"
    },
    {
      "when": "'code-reviewer' in ${bundle.input.subagents}",
      "name": "code-reviewer",
      "source": "subagents/code-reviewer/code-reviewer.md"
    },
    {
      "when": "'test-runner' in ${bundle.input.subagents}",
      "name": "test-runner",
      "source": "subagents/test-runner/test-runner.md"
    }
  ],

  "commands": [
    {
      "name": "build-check",
      "source": "commands/build-check.md"
    },
    {
      "when": "'review' in ${bundle.input.skills}",
      "name": "review",
      "source": "commands/review.md"
    }
  ],

  "skills": [
    {
      "when": "'review' in ${bundle.input.skills}",
      "name": "review",
      "source": "skills/review/"
    },
    {
      "when": "'security-review' in ${bundle.input.skills}",
      "name": "security-review",
      "source": "skills/security-review/"
    },
    {
      "when": "'kotlin-build' in ${bundle.input.skills}",
      "name": "kotlin-build",
      "source": "skills/kotlin-build/"
    }
  ],

  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "command": ".claude/hooks/session-start.sh"
      }
    ],
    "PreToolUse": [
      {
        "when": "${bundle.input.strict}",
        "matcher": "Bash",
        "command": ".claude/strict/hooks/block-dangerous.sh"
      }
    ],
    "PostToolUse": [
      {
        "when": "'ktlint' in ${bundle.input.qualityTools}",
        "matcher": "Edit|Write",
        "command": ".claude/hooks/post-edit-ktlint.sh"
      }
    ],
    "Stop": [
      {
        "when": "'detekt' in ${bundle.input.qualityTools}",
        "matcher": "*",
        "command": ".claude/hooks/stop-detekt.sh"
      }
    ]
  }
}
